# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Ключ Gemini API из Google AI Studio
GEMINI_API_KEY=AIzaSy...

# Список моделей через запятую — они появятся в /model
AVAILABLE_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-2.5-pro,gemini-1.5-flash
DEFAULT_MODEL=gemini-2.5-flash

# Сколько последних сообщений (реплик) держим в контексте диалога
MAX_HISTORY_MESSAGES=20

# Лимиты запросов на пользователя
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100

# Telegram user_id через запятую, которым разрешено пользоваться ботом.
# Пусто = бот отвечает всем подряд (публичный режим). Свой user_id можно
# узнать у @userinfobot.
ALLOWED_USER_IDS=

# Путь к файлу SQLite базы данных
DB_PATH=data/bot.db

# Голос для озвучки TTS и аудио-ответов (Aoede, Puck, Charon, Kore, Fenrir)
TTS_VOICE=Aoede

# System instruction для Gemini — тон, язык, персона ответов.
# Пусто = без system instruction, поведение Gemini по умолчанию.
# Каждый пользователь может настроить свой промпт через /prompt.
SYSTEM_PROMPT=Отвечай кратко и по-русски, как системному администратору: сразу решение, без вступлений и разжёвывания очевидного. Команды и конфиги — только как code-блоки, без лишних пояснений вокруг них.

