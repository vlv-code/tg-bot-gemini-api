# ==============================================================================
# ОБЯЗАТЕЛЬНЫЕ КЛЮЧИ И ТОКЕНЫ
# ==============================================================================
# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Ключ Gemini API из Google AI Studio
GEMINI_API_KEY=AIzaSy...

# ==============================================================================
# ДИНАМИЧЕСКИЙ КАТАЛОГ МОДЕЛЕЙ И НАСТРОЙКИ ПО РЕЖИМАМ
# ==============================================================================
# Бот автоматически сканирует актуальные эндпоинты через Google GenAI API
# и кэширует их в SQLite (таблица discovered_models).
# Нижеперечисленные параметры определяют начальные модели по умолчанию для каждого режима:

# 🥊 Stand-режим: модель по умолчанию для основного чата и ответов ИИ-стенда
DEFAULT_MODEL=gemini-3.5-flash-lite

# 🎭 Avatar-режим: модель по умолчанию для суфлёра (/q, /avatar и инлайн)
# Пусто = использовать DEFAULT_MODEL
DEFAULT_AVATAR_MODEL=

# 💼 Business-режим: модель для Secretary Mode (черновики и авто-ответы клиентам)
# Пусто = использовать DEFAULT_MODEL
DEFAULT_BUSINESS_MODEL=

# 🎙 Voice-to-Text (STT): модель по умолчанию для расшифровки входящего аудио/голоса
# Пусто = использовать DEFAULT_MODEL
DEFAULT_STT_MODEL=

# 🎧 Модель для генерации речи TTS и список доступных в меню
TTS_MODEL=gemini-3.8-flash-tts
AVAILABLE_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts

# Список резервных текстовых моделей для меню /model (если API Google временно недоступен)
AVAILABLE_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.8-flash-lite,gemini-3.6-flash,gemini-4-argon

# Интервал авто-синхронизации моделей с Google GenAI API в часах (0 = отключить)
MODELS_SYNC_INTERVAL_HOURS=24

# Таймаут запросов к Gemini API в секундах (при 503/504 бот автоматически переключается на fallback)
GEMINI_TIMEOUT_SECONDS=35.0

# ==============================================================================
# ПАРАМЕТРЫ ДИАЛОГОВ И ЛИМИТЫ
# ==============================================================================
# Сколько последних сообщений (реплик) держим в контексте диалога
MAX_HISTORY_MESSAGES=20

# Лимиты запросов на пользователя (подстроены под 15 RPM и 500 RPD для Gemini 3.5 Flash Lite)
RATE_LIMIT_PER_MINUTE=15
RATE_LIMIT_PER_DAY=500

# Telegram user_id через запятую, которым разрешено пользоваться ботом.
# Пусто = бот отвечает всем подряд (публичный режим). Свой user_id можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# Список Telegram user_id суперадминистраторов через запятую (например: 12345678,87654321)
ADMIN_IDS=

# Максимальное количество одновременных запросов к Gemini API (глобальная очередь)
MAX_CONCURRENT_REQUESTS=5

# Путь к файлу SQLite базы данных
DB_PATH=data/bot.db

# ==============================================================================
# ГОЛОСОВОЙ ИНТЕРФЕЙС И ОЗВУЧКА (TTS)
# ==============================================================================
# Голос по умолчанию для озвучки TTS и список доступных голосов (Aoede, Kore, Puck, Fenrir, Charon)
TTS_VOICE=Aoede
AVAILABLE_VOICES=Aoede,Kore,Puck,Fenrir,Charon

# Задержка (в секундах) перед запуском генерации TTS в инлайн-режиме (debounce при наборе текста)
# Рекомендуется 0.5 - 1.0 сек (таймаут Telegram на ответ инлайн-запроса составляет ~4-5 сек)
INLINE_TTS_DEBOUNCE_SECONDS=0.8

# Опциональный chat_id приватного канала или группы-отстойника, куда бот добавлен админом,
# для тихого upload voice_file_id для инлайна (например: -1001234567890)
TTS_DUMP_CHAT_ID=

# Время жизни кнопок под интерактивным инлайн-сообщением в секундах (по умолчанию 30, 0 = не удалять)
INLINE_BUTTONS_TTL_SECONDS=30

# ==============================================================================
# СИСТЕМНЫЕ ПРОМПТЫ ПО УМОЛЧАНИЮ
# ==============================================================================
# System instruction для Stand-режима — тон, язык, персона ответов.
# Пусто = без system instruction, поведение Gemini по умолчанию.
# Каждый пользователь может настроить свой промпт через /prompt.
SYSTEM_PROMPT=Отвечай кратко и по-русски, как системному администратору: сразу решение, без вступлений и разжёвывания очевидного. Команды и конфиги — только как code-блоки, без лишних пояснений вокруг них.

# Глобальный стиль Режима Аватара по умолчанию (если пользователь не выбрал свою Личность).
# Базовые правила суфлёра (1-е лицо, запрет на общение с ботом и подтверждение команд) вшиты в движок бота.
# Здесь задаётся только манера общения и характер:
AVATAR_PROMPT=Write naturally, wittily, concisely, and confidently, matching the emotional tone and level of formality of the conversation.
# (Или по-русски: AVATAR_PROMPT=Пиши живо, естественно, остроумно и уверенно, перенимая эмоциональный тон и уровень формальности переписки.)

